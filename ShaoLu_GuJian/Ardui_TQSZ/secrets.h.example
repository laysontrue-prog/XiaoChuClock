// ============================================================
//  和风天气 API Key —— 模板文件
// ============================================================
//  用法：
//    1) 把这个文件复制一份，改名为 secrets.h（同目录）
//    2) 把下面的 KEY 换成你自己的和风天气 Key
//    3) 申请地址： https://console.qweather.com/
//
//  ⚠️ secrets.h 是【私密文件】：
//     · 不要提交到 git 仓库
//     · 不要打进要分享的压缩包
//     · 本模板文件（.example 结尾）才是应该随包发布的
// ============================================================
#ifndef SECRETS_H
#define SECRETS_H

// ---- API 域名 ----
// 大多数账号这两行【不用改】，保持默认即可。
// API Host 在【控制台 → 设置】里看（不是"项目管理"/"凭据"页），形如 h2a9cf3mhs.xy.qweatherapi.com
// 填法：城市查询那行末尾要带 /geo，天气那行不带
//         #define QW_GEO "https://你的host/geo"
//         #define QW_API "https://你的host"
// 不填也能编译，但新账号用公共域名会返回 403 Invalid Host，拿不到天气。
#define QW_GEO "https://geoapi.qweather.com"
#define QW_API "https://devapi.qweather.com"

#define KEY ""   // ← 在这里填入你的和风天气 API Key

#endif
